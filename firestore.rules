rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all documents for authenticated users
    match /{document=**} {
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to create and update letters
    match /letters/{letterId} {
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Allow authenticated users to create, update, and delete comments
    match /comments/{commentId} {
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || isAdmin());
    }
    
    // Direct messages rules
    match /messages/{messageId} {
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.senderId || 
                   request.auth.uid == resource.data.recipientId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && 
                    (request.auth.uid == resource.data.recipientId && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
    }
    
    // Conversations rules
    match /conversations/{conversationId} {
      allow read: if request.auth != null && 
                  request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && 
                    request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null && 
                    request.auth.uid in resource.data.participantIds;
    }
    
    // Allow users to read/write their own user data with username change restrictions
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && 
                    (
                      // If username is being changed, check the lastUsernameChange date
                      !("username" in request.resource.data && resource.data.username != request.resource.data.username) ||
                      !("lastUsernameChange" in resource.data) ||
                      resource.data.lastUsernameChange == null ||
                      request.time.toMillis() - resource.data.lastUsernameChange.toMillis() >= 30 * 24 * 60 * 60 * 1000
                    );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read/write their own saved letters
    match /saved/{docId} {
      allow read, write: if request.auth != null && docId.split('_')[0] == request.auth.uid;
    }
    
    // Allow users to create reports
    match /reports/{reportId} {
      allow create: if request.auth != null;
    }
    
    // Allow users to read/write their own presence data
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && userId == request.auth.uid;
    }
    
    // Allow users to read/write their own private letters
    match /privateLetters/{letterId} {
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.senderId || 
                   request.auth.uid == resource.data.recipientId);
      allow create: if request.auth != null;
      allow delete: if request.auth != null && 
                    (request.auth.uid == resource.data.senderId || 
                     request.auth.uid == resource.data.recipientId);
    }
    
    // Allow users to read/write letter views
    match /letterViews/{viewId} {
      allow read, write: if request.auth != null;
    }
    
    // Rules for the usernames collection
    match /usernames/{username} {
      allow read: if request.auth != null;
      // Only allow creating if the username doesn't exist or is marked as deleted
      allow create: if request.auth != null && 
                    (!exists(/databases/$(database)/documents/usernames/$(username)) || 
                     get(/databases/$(database)/documents/usernames/$(username)).data.deleted == true);
      // Only allow updates by the owner or if the username is being marked as deleted
      allow update: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || 
                     request.resource.data.deleted == true);
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth.token.email == "admin@lettershare.com";
    }
    
    // Helper function to check if a user is a participant in a conversation
    function isParticipant(userA, userB, requestingUser) {
      return userA == requestingUser || userB == requestingUser;
    }
  }
}
